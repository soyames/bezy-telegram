{
  "name": "bezy-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "harness": "node tests/harness.mjs",
    "test": "node tests/run.mjs all --project=chromium",
    "test:contract": "node tests/contract.test.mjs",
    "test:e2e": "node tests/run.mjs e2e --project=chromium",
    "test:e2e:browsers": "playwright test tests/e2e/browsers.spec.js",
    "test:e2e:degraded": "playwright test tests/e2e/degraded.spec.js --project=chromium",
    "test:all": "node tests/run.mjs all",
    "test:security": "node tests/run.mjs security",
    "test:localization": "node tests/localization.test.mjs",
    "test:smoke": "node tests/smoke.test.mjs",
    "retention": "node scripts/retention.mjs",
    "reminders": "node scripts/profile-reminders.mjs",
    "support": "node scripts/list-support.mjs",
    "outcomes": "node scripts/outcome-eval.mjs",
    "reports": "node scripts/report-stats.mjs",
    "rate-limits": "node scripts/rate-limit-status.mjs",
    "sync:fallback": "node scripts/sync-fallback-locale.mjs",
    "test:backend": "node tests/run.mjs backend",
    "test:translation": "node tests/run.mjs profileText",
    "test:db": "node tests/run.mjs db",
    "test:game": "node tests/run.mjs game",
    "db:health": "node scripts/db-health.mjs",
    "funnel": "node scripts/funnel.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
