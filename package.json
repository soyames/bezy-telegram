{
  "name": "bezy-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "harness": "node tests/harness.mjs",
    "test": "node tests/contract.test.mjs && node tests/localization.test.mjs && node tests/backend.test.mjs && node tests/security.test.mjs",
    "test:contract": "node tests/contract.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:browsers": "playwright test tests/e2e/browsers.spec.js",
    "test:e2e:degraded": "playwright test tests/e2e/degraded.spec.js --project=chromium",
    "test:all": "npm test && npm run test:e2e",
    "test:security": "node tests/security.test.mjs",
    "test:localization": "node tests/localization.test.mjs",
    "test:smoke": "node tests/smoke.test.mjs",
    "retention": "node scripts/retention.mjs",
    "reminders": "node scripts/profile-reminders.mjs",
    "support": "node scripts/list-support.mjs",
    "reports": "node scripts/report-stats.mjs",
    "rate-limits": "node scripts/rate-limit-status.mjs",
    "sync:fallback": "node scripts/sync-fallback-locale.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
