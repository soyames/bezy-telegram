rules_version = '2';

// Bezy uses Firestore as a server-side database only.
// The Mini App never connects directly to Firestore.
// Vercel API routes use the Firebase Admin SDK, which bypasses these rules.
// Keep all direct client access denied unless the architecture explicitly changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
